+    const uint tlo = ((lo * 3u) >> 8u) & 0x00030003u;   // trits of b0 (bits 0-1) and b2 (bits 16-17)
+    const uint thi = ((hi * 3u) >> 8u) & 0x00030003u;   // trits of b1 and b3
+    return tlo | (thi << 8u);
